# ==============================================================================
# ChargeGuard AI Pro — Environment Configuration Example
# ==============================================================================

# Server Environment
ENVIRONMENT=development
DEBUG=True

# Backend Host & Port
HOST=127.0.0.1
PORT=8000

# SQLite Database Location
DATABASE_URL=sqlite:///./chargeguard.db

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Hardware Serial Bridge Settings (Optional, when physical bench is attached)
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
DEVICE_ID=esp32-bench-01

# Telemetry Engineering Safety Thresholds (5.0V DC Profile)
MAX_SOURCE_VOLTAGE=5.50
MIN_SOURCE_VOLTAGE=4.50
MAX_CURRENT=3.50
MAX_NORMAL_VOLTAGE_DROP=0.250
MAX_ALLOWED_VOLTAGE_DROP=0.500
MAX_NORMAL_RESISTANCE_OHMS=0.180
MAX_ALLOWED_RESISTANCE_OHMS=0.300
MAX_NORMAL_TEMP_C=40.0
MAX_CRITICAL_TEMP_C=50.0

# WebSocket Broadcast Throttle (seconds)
WS_THROTTLE_INTERVAL=0.1
